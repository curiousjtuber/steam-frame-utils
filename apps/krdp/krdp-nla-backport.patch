From 395d63013dbe730fa5de9249fa3d9f0734b5399b Mon Sep 17 00:00:00 2001
From: David Edmundson <kde@davidedmundson.co.uk>
Date: Fri, 2 Oct 2026 14:50:48 +0000
Subject: [PATCH 3/3] Fix authentication with FreeRDP 3.32

FreeRDP 3.32 enables extended security by default. This causes
PROTOCOL_HYBRID_EX to be selected even when KRDP explicitly selects
TLS or NLA for its authentication mode.

Explicitly disable extended security so that KRDP's configured
security mode is used.

(cherry picked from commit f868133d9115a3bc2f02287fed57bf94f9ccad50)

Co-authored-by: Ben Marshall <ceylon@leavesoftea.net>
(cherry picked from commit 31824f94c16bb4ccfc7739c2669bda1b3f5ca94b)
---
 src/RdpConnection.cpp | 1 +
 1 file changed, 1 insertion(+)

diff --git a/src/RdpConnection.cpp b/src/RdpConnection.cpp
index 4d63fd6..b088046 100644
--- a/src/RdpConnection.cpp
+++ b/src/RdpConnection.cpp
@@ -413,6 +413,7 @@ void RdpConnection::initialize()
     freerdp_settings_set_bool(settings, FreeRDP_RdpSecurity, false);
     freerdp_settings_set_bool(settings, FreeRDP_TlsSecurity, usePamAuthentication);
     freerdp_settings_set_bool(settings, FreeRDP_NlaSecurity, !usePamAuthentication);
+    freerdp_settings_set_bool(settings, FreeRDP_ExtSecurity, false);
 
     freerdp_settings_set_uint32(settings, FreeRDP_OsMajorType, OSMAJORTYPE_UNIX);
     // PSEUDO_XSERVER is apparently required for things to work properly.
-- 
2.56.0

