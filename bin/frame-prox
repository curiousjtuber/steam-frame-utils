#!/usr/bin/env bash
# steam-frame-utils: the proximity sensor that tells SteamVR whether the Frame
# is worn. Details:
# https://github.com/curiousjtuber/steam-frame-utils#proximity-sensor
#
# Usage:  frame-prox                  a reading, the factory calibration, the Presence Sensor
#                                     setting, and the threshold SteamVR works out from them
#         frame-prox --watch [SECS]   a reading every SECS (0.3) until Ctrl-C, against that
#                                     threshold
#         frame-prox --set MODE       set the Presence Sensor (VR Settings > Startup / Shutdown):
#                                     normal (the default) or high (High Sensitivity, which
#                                     detects you from further away)
#
# --set needs SteamVR running: it goes through vrcmd, and the driver takes it at once.

set -euo pipefail

if [[ -n ${CONTAINER_ID:-} || -e /run/.containerenv ]]; then
  exec distrobox-host-exec "$0" "$@"
fi

KEY=steamvr.proxThresholdMode
OLD_KEY=driver_cv.proxSensorThresholdMultipleConst

usage() { sed -n '2,/^$/s/^# \{0,1\}//p' "$0"; }
die() { echo "frame-prox: $*" >&2; exit 1; }
running() { systemctl --user is-active --quiet steamvr.service; }

watch=0 interval=0.3 set=
case ${1:-} in
  '') ;;
  -w|--watch) watch=1 interval=${2:-$interval} ;;
  --set)
    case ${2:-} in
      normal|0) set=0 ;;
      high|1) set=1 ;;
      *) die "--set takes normal or high" ;;
    esac ;;
  -h|--help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

raw=
for dev in /sys/bus/iio/devices/*; do
  [[ -r $dev/in_proximity_raw ]] && { raw=$dev/in_proximity_raw; break; }
done
[[ -n $raw ]] || die "no proximity sensor under /sys/bus/iio/devices"

log=$(steamvr logpath)/vrserver.txt
user_settings=$(steamvr configpath)/steamvr.vrsettings

eeprom() { /usr/lib/deckard-eeprom/eeprom_console get "$1" 2>/dev/null | tail -n1; }

# setting TYPE SECTION.KEY -- the value SteamVR uses, defaults included
setting() {
  local value
  value=$(steamvr cmd "--settings-$1" "$2")
  value=${value#*=}
  # vrcmd prints floats as 1.050000, from single precision.
  [[ $1 == float && -n $value ]] && value=$(printf '%.6g' "$value")
  echo "$value"
}

# The Presence Sensor mode: 0 Normal, 1 High Sensitivity. With SteamVR running, vrcmd gives
# the value in force; otherwise the user's file, and the default when it isn't there.
mode() {
  local value=
  if running; then
    value=$(setting int "$KEY")
  elif [[ -r $user_settings ]]; then
    value=$(jq -r ".${KEY%%.*}.\"${KEY#*.}\" // empty" "$user_settings" 2>/dev/null)
  fi
  [[ $value == 1 ]] && echo 1 || echo 0
}

# The cv driver takes the threshold as prox_far times a constant for the mode (see the README
# for how these were found), and reports "worn" while the reading is above it.
multiplier() { [[ $1 == 1 ]] && echo 0.65 || echo 0.8; }
mode_name() { [[ $1 == 1 ]] && echo 'High Sensitivity' || echo Normal; }

if [[ -n $set ]]; then
  # Editing steamvr.vrsettings by hand doesn't stick: a running vrserver writes back the
  # settings it holds in memory on its next change.
  running || die "SteamVR isn't running; --set changes the setting through it"
  steamvr cmd --set-settings-int "$KEY" "$set" >/dev/null
  sleep 0.5
fi

prox_far=$(eeprom prox_far)
[[ $prox_far =~ ^[0-9]+$ ]] || die "can't read prox_far from the EEPROM (got '$prox_far')"
mode=$(mode)
mult=$(multiplier "$mode")
threshold=$(awk -v f="$prox_far" -v m="$mult" 'BEGIN { printf "%.2f", f * m }')

if (( watch )); then
  printf 'threshold %s (prox_far %s x %s, %s); Ctrl-C to stop\n' "$threshold" "$prox_far" \
    "$mult" "$(mode_name "$mode")"
  printf '%-8s %8s %10s  %s\n' time reading -threshold state
  while :; do
    awk -v r="$(<"$raw")" -v t="$threshold" -v now="$(date +%T)" \
      'BEGIN { printf "%-8s %8.2f %+10.2f  %s\n", now, r, r - t, (r > t) ? "worn" : "not worn" }'
    sleep "$interval"
  done
fi

printf 'reading     %.2f  (higher is closer; %s)\n' "$(<"$raw")" "${raw%/*}"
printf 'factory     prox_far %s, prox_noise %s  (EEPROM; the driver uses prox_far)\n' \
  "$prox_far" "$(eeprom prox_noise)"
printf 'setting     %s %s  (%s; the default 0 is Normal)\n' "$KEY" "$mode" \
  "$(mode_name "$mode")"
printf 'threshold   %s  (prox_far x %s; worn while the reading is above it)\n' "$threshold" \
  "$mult"
if running; then
  printf '            driver_cv.disableProxSensor %s\n' "$(setting bool driver_cv.disableProxSensor)"
else
  echo '            SteamVR is not running; the setting is from steamvr.vrsettings'
fi

# The driver logs the prox_far it read, at startup.
if [[ -r $log ]]; then
  line=$(grep -F '[CHmdDirectDeviceControl] Proximity sensing' "$log" | tail -n1)
  if [[ $line == *'enable: proxfar'* ]]; then
    printf 'SteamVR     read prox_far %s  (vrserver.txt, %s)\n' \
      "$(sed -n 's/.*proxfar \([0-9]*\).*/\1/p' <<<"$line")" "$(awk '{print $5}' <<<"$line" | cut -d. -f1)"
  elif [[ $line == *disabled* ]]; then
    echo 'SteamVR     proximity sensing disabled: the driver could not read prox_far (vrserver.txt)'
  else
    echo "SteamVR     no proximity line in $log yet"
  fi
fi

# The key SteamOS 0.4.1 to 0.4.3 used. 0.4.4 dropped it, but it stays in the file.
if [[ -r $user_settings ]]; then
  old=$(jq -r ".${OLD_KEY%%.*}.\"${OLD_KEY#*.}\" // empty" "$user_settings" 2>/dev/null)
  [[ -n $old ]] && printf 'note        %s %s is in %s; SteamOS 0.4.4 ignores it\n' \
    "$OLD_KEY" "$(printf '%.6g' "$old")" "${user_settings/#$HOME/\~}"
fi
exit 0
