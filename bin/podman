#!/bin/sh
# Frame desktop mode runs Plasma nested in gamescope with its own XDG_RUNTIME_DIR
# and a private D-Bus that has no systemd --user; rootless podman needs the real ones.
case "$XDG_RUNTIME_DIR" in
  */nested_plasma)
    XDG_RUNTIME_DIR=/run/user/$(id -u)
    DBUS_SESSION_BUS_ADDRESS=unix:path=$XDG_RUNTIME_DIR/bus
    export XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS ;;
esac
exec /usr/bin/podman "$@"
